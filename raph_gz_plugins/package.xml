<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>raph_gz_plugins</name>
    <version>0.0.1</version>

    <description>Plugins for Raph Rover Gazebo simulation in ROS 2</description>

    <maintainer email="support@fictionlab.pl">Fictionlab</maintainer>
    <license>MIT</license>
    <author email="janek@fictionlab.pl">Jan Hernas</author>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <exec_depend>gz_plugin_vendor</exec_depend>
    <exec_depend>gz_sim_vendor</exec_depend>
    <exec_depend>gz_transport_vendor</exec_depend>
    <exec_depend>gz_msgs_vendor</exec_depend>
    <exec_depend>ackermann_msgs</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>raph_interfaces</exec_depend>
    <exec_depend>ros_gz_bridge</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_cmake_copyright</test_depend>
    <test_depend>ament_cmake_cpplint</test_depend>
    <test_depend>ament_cmake_lint_cmake</test_depend>
    <test_depend>ament_cmake_uncrustify</test_depend>
    <test_depend>ament_cmake_xmllint</test_depend>
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>